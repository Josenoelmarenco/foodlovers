# ============================================================
# Dependencies & build output
# ============================================================
node_modules/
dist/
build/
.next/
.cache/
.parcel-cache/
.vite/
*.tsbuildinfo

# TypeScript declarations generated from .ts config files
# (vite.config.ts → vite.config.d.ts, etc.)
frontend/*.config.d.ts
backend/*.config.d.ts

# Compiled JS output of TypeScript config files. The .ts versions
# are the source of truth — these .js files used to be emitted when
# tsconfig.node.json had composite:true and confuse the build.
frontend/vite.config.js
frontend/vitest.config.js
frontend/tailwind.config.js

# ============================================================
# Env files (never commit secrets)
# ============================================================
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# ============================================================
# Prisma
# ============================================================
backend/prisma/migrations/dev.db*

# ============================================================
# Test artifacts
# ============================================================
coverage/
.nyc_output/
*.lcov

# ============================================================
# Logs
# ============================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================================
# Editors
# ============================================================
.vscode/
.idea/
*.iml
tempCodeRunnerFile.js
*.swp
*.swo

# ============================================================
# macOS / Windows
# ============================================================
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ============================================================
